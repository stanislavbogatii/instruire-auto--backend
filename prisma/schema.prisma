generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  hash         String
  firstName    String?       @default("")
  lastName     String?       @default("")
  phone        String?       @default("")
  privateMessage String?     @default("")
  role         Role          @default(USER)
  groupId      Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
  group        Group?        @relation(fields: [groupId], references: [id])

  @@index([groupId], map: "User_groupId_fkey")
}

model Group {
  id           Int         @id @default(autoincrement())
  name         String
  token        String      @unique
  instructorId Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  instructor   Instructor? @relation(fields: [instructorId], references: [id])
  users        User[]

  @@index([instructorId], map: "Group_instructorId_fkey")
}

model Reservation {
  id             Int        @id @default(autoincrement())
  userId         Int
  instructorId   Int
  startTime      DateTime
  sector         String?    @default("")
  gearbox        String?    @default("")
  privateMessage String?    @default("")
  color          String?    @default("")  // Add this line
  createdAt      DateTime   @default(now())
  instructor     Instructor @relation(fields: [instructorId], references: [id])
  user           User       @relation(fields: [userId], references: [id])

  @@index([instructorId], map: "Reservation_instructorId_fkey")
  @@index([userId], map: "Reservation_userId_fkey")
}

model Car {
  id          Int         @id @default(autoincrement())
  plateNumber String      @unique
  instructor  Instructor? @relation(fields: [instructorId], references: [id])
  instructorId Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([instructorId], map: "Car_instructorId_fkey")
}

model Instructor {
  id           Int           @id @default(autoincrement())
  firstName    String
  lastName     String
  phone        String
  sector       String?      @default("") 
  groups       Group[]
  reservations Reservation[]
  cars         Car[]
}

enum Role {
  USER
  MANAGER
  ADMIN
}
