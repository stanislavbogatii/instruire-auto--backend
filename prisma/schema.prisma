generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                  Int                     @id @default(autoincrement())
  email               String                  @unique
  hash                String

  medical_documents      Boolean                 @default(false)
  individual_work        Boolean                 @default(false)
  number_of_absences     Int                     @default(0)
  canBookPracticalExam   Boolean                 @default(false)

  color               String?                 @default("")
  role                Role                    @default(USER)
  groupId             Int?
  desiredInstructorId Int?
  professorGroups     Group[]                 @relation("ProfessorGroups")
  managerGroups       ManagerGroup[]          @relation("ManagerGroups")
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  firstName           String?                 @default("")
  lastName            String?                 @default("")
  phone               String?                 @default("")
  privateMessage      String?                 @default("")
  userId              Int?                    @unique
  idnp                String?                 @default("")
  exams               Exam[]
  instructorProfile   Instructor?             @relation("UserInstructor")
  desiredInstructor   Instructor?             @relation("DesiredInstructor", fields: [desiredInstructorId], references: [id])
  Note                Note[]
  reservations        Reservation[]
  changedReservations ReservationHistory[]    @relation("ChangedByUser")
  reservationHistory  ReservationHistory[]
  examPermissions     StudentExamPermission[]
  studentTickets      StudentTicket[]
  practicalExamSlotReservations PracticalExamSlotReservation[]
  instructorRatings             InstructorRating[]
  lessonVideoSends               LessonVideoSend[]
  notifications                  Notification[]
  chatConversation               ChatConversation? @relation("ChatConversationStudent")
  sentChatMessages               ChatMessage[]     @relation("ChatMessageSender")
  group               Group?                  @relation(fields: [groupId], references: [id])

  @@index([groupId], map: "User_groupId_fkey")
  @@index([userId], map: "User_userId_fkey")
  @@index([desiredInstructorId])
}

model Group {
  id           Int         @id @default(autoincrement())
  name         String
  token        String      @unique
  instructorId Int?
  professorId   Int?
  sector       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  instructor   Instructor? @relation(fields: [instructorId], references: [id])
  professor    User?        @relation("ProfessorGroups", fields: [professorId], references: [id])
  users        User[]
  managerAssignments ManagerGroup[] @relation("GroupManagers")

  @@index([instructorId], map: "Group_instructorId_fkey")
}

model ManagerGroup {
  id        Int      @id @default(autoincrement())
  managerId Int
  groupId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  manager   User     @relation("ManagerGroups", fields: [managerId], references: [id], onDelete: Cascade)
  group     Group    @relation("GroupManagers", fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([managerId, groupId])
  @@index([managerId])
  @@index([groupId])
}

model Reservation {
  id                 Int                  @id @default(autoincrement())
  userId             Int
  instructorId       Int?
  startTime          DateTime
  createdAt          DateTime             @default(now())
  gearbox            String?              @default("")
  privateMessage     String?              @default("")
  sector             String?              @default("")
  color              String?              @default("")
  carId              Int?
  instructorsGroupId Int?
  isConfirmed        Boolean              @default(false)
  updatedAt          DateTime             @default(now()) @updatedAt
  isCancelled        Boolean              @default(false)
  isFavorite         Boolean              @default(false)
  isImportant        Boolean              @default(false)
  deletedAt          DateTime?
  car                Car?                 @relation(fields: [carId], references: [id])
  instructor         Instructor?          @relation(fields: [instructorId], references: [id])
  instructorsGroup   InstructorsGroup?    @relation(fields: [instructorsGroupId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
  history            ReservationHistory[]
  rating             InstructorRating?
  videoSend          LessonVideoSend?

  @@index([instructorId], map: "Reservation_instructorId_fkey")
  @@index([userId], map: "Reservation_userId_fkey")
  @@index([carId], map: "Reservation_carId_fkey")
  @@index([instructorsGroupId])
  @@index([deletedAt])
}

model ReservationHistory {
  id                 Int               @id @default(autoincrement())
  reservationId      Int
  userId             Int
  instructorId       Int?
  carId              Int?
  instructorsGroupId Int?
  startTime          DateTime
  sector             String?           @default("")
  gearbox            String?           @default("")
  privateMessage     String?           @default("")
  color              String?           @default("")
  isConfirmed        Boolean           @default(false)
  action             HistoryAction
  changedBy          Int?
  changedFields      Json?
  createdAt          DateTime          @default(now())
  car                Car?              @relation(fields: [carId], references: [id])
  changedByUser      User?             @relation("ChangedByUser", fields: [changedBy], references: [id])
  instructor         Instructor?       @relation(fields: [instructorId], references: [id])
  instructorsGroup   InstructorsGroup? @relation(fields: [instructorsGroupId], references: [id])
  reservation        Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id])

  @@index([reservationId], map: "ReservationHistory_reservationId_fkey")
  @@index([userId], map: "ReservationHistory_userId_fkey")
  @@index([instructorId], map: "ReservationHistory_instructorId_fkey")
  @@index([carId], map: "ReservationHistory_carId_fkey")
  @@index([instructorsGroupId])
  @@index([changedBy], map: "ReservationHistory_changedBy_fkey")
}

model Car {
  id                 Int                  @id @default(autoincrement())
  plateNumber        String               @unique
  instructorId       Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  gearbox            String?
  instructor         Instructor?          @relation(fields: [instructorId], references: [id])
  reservations       Reservation[]
  reservationHistory ReservationHistory[]

  @@index([instructorId], map: "Car_instructorId_fkey")
}

model InstructorsGroup {
  id                 Int                  @id @default(autoincrement())
  name               String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sector             String?              @default("")
  order              Int                  @default(0)
  instructors        Instructor[]
  reservations       Reservation[]
  reservationHistory ReservationHistory[]
}

model Instructor {
  id                 Int                          @id @default(autoincrement())
  firstName          String
  lastName           String
  phone              String
  sector             String?                      @default("")
  isActive           Boolean                      @default(true)
  instructorsGroupId Int?
  userId             Int?                         @unique
  order              String?
  color              String?                      @default("")
  instructorType     InstructorType               @default(BAZA)
  isExamen           Boolean                      @default(false)
  cars               Car[]
  exams              Exam[]
  groups             Group[]
  instructorsGroup   InstructorsGroup?            @relation(fields: [instructorsGroupId], references: [id])
  user               User?                        @relation("UserInstructor", fields: [userId], references: [id])
  desiredByUsers     User[]                       @relation("DesiredInstructor")
  blackouts          InstructorBlackout[]
  reservations       Reservation[]
  reservationHistory ReservationHistory[]
  examPermissions    StudentExamPermission[]
  sectorSchedule     InstructorSectorSchedule[]
  practicalExamSlots PracticalExamSlot[]
  substitutionsAsBase       InstructorSubstitution[] @relation("BaseInstructor")
  substitutionsAsSubstitute InstructorSubstitution[] @relation("SubstituteInstructor")
  ratings                   InstructorRating[]
  videoSends                LessonVideoSend[]

  @@index([instructorsGroupId])
  @@index([userId], map: "Instructor_userId_fkey")
}

model InstructorSectorSchedule {
  id           Int        @id @default(autoincrement())
  instructorId Int
  dayOfWeek    Int        // 1=Luni, 2=Marti, 3=Miercuri, 4=Joi, 5=Vineri, 6=Sambata, 7=Duminica
  sector       String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, dayOfWeek])
  @@index([instructorId])
}

model InstructorBlackout {
  id              Int                    @id @default(autoincrement())
  dateTime        DateTime
  instructorId    Int
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  endDateTime     DateTime?
  startDateTime   DateTime?
  type            InstructorBlackoutType @default(SINGLE)
  repeatEveryDays Int                    @default(0)
  instructor      Instructor             @relation(fields: [instructorId], references: [id])

  @@unique([instructorId, dateTime])
}

model Question {
  id                   Int                   @id @default(autoincrement())
  text                 String                @db.Text
  image                String?
  answers              String                @db.Text
  correctAnswer        Int
  hint                 String?               @db.Text
  categoryId           Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  category             QuestionCategory?     @relation(fields: [categoryId], references: [id])
  examQuestions        ExamQuestion[]
  studentTicketAnswers StudentTicketAnswer[]
  ticketQuestions      TicketQuestion[]

  @@index([categoryId])
}

model QuestionCategory {
  id        Int        @id @default(autoincrement())
  nameRo    String
  nameRu    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  questions Question[]
}

model Ticket {
  id             Int              @id @default(autoincrement())
  name           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  type           QuestionType     @default(EXAM)
  examTickets    ExamTicket[]
  studentTickets StudentTicket[]
  questions      TicketQuestion[]
}

model TicketQuestion {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  questionId Int
  order      Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, questionId])
  @@index([ticketId])
  @@index([questionId])
}

model StudentTicket {
  id                Int                   @id @default(autoincrement())
  userId            Int
  ticketId          Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  completedAt       DateTime?
  lastQuestionIndex Int?
  score             Int?
  startedAt         DateTime?
  status            PracticeStatus        @default(NOT_STARTED)
  totalQuestions    Int?
  ticket            Ticket                @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers           StudentTicketAnswer[]

  @@index([userId])
  @@index([ticketId])
}

model StudentTicketAnswer {
  id              Int           @id @default(autoincrement())
  studentTicketId Int
  questionId      Int
  selectedAnswer  Int?
  isCorrect       Boolean?
  answeredAt      DateTime?
  order           Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  question        Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentTicket   StudentTicket @relation(fields: [studentTicketId], references: [id], onDelete: Cascade)

  @@unique([studentTicketId, questionId])
  @@index([studentTicketId])
  @@index([questionId])
}

model Exam {
  id             Int            @id @default(autoincrement())
  userId         Int
  instructorId   Int?
  status         ExamStatus     @default(IN_PROGRESS)
  score          Int?
  totalQuestions Int            @default(0)
  passScore      Int            @default(22)
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  timeLimit      Int            @default(30)
  attemptNumber  Int            @default(1)
  instructor     Instructor?    @relation(fields: [instructorId], references: [id])
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions      ExamQuestion[]
  examTickets    ExamTicket[]

  @@index([userId])
  @@index([instructorId])
}

model ExamTicket {
  id       Int    @id @default(autoincrement())
  examId   Int
  ticketId Int
  exam     Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([examId, ticketId])
  @@index([examId])
  @@index([ticketId])
}

model ExamQuestion {
  id             Int       @id @default(autoincrement())
  examId         Int
  questionId     Int
  selectedAnswer Int?
  isCorrect      Boolean?
  answeredAt     DateTime?
  order          Int
  image          String?
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
}

model StudentExamPermission {
  id           Int         @id @default(autoincrement())
  userId       Int
  instructorId Int?
  isActive     Boolean     @default(true)
  validUntil   DateTime
  maxAttempts  Int         @default(3)
  usedAttempts Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  granterId    Int         @default(0)
  granterType  Role        @default(INSTRUCTOR)
  instructor   Instructor? @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([instructorId])
  @@index([granterId])
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  date      DateTime @default(now())
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  USER
  MANAGER
  ADMIN
  INSTRUCTOR
  PROFESSOR
}

enum HistoryAction {
  CREATE
  UPDATE
  DELETE
  CONFIRM
  UNCONFIRM
  RESTORE
}

enum ExamStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
}

enum PracticeStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PASSED
  FAILED
}

enum QuestionType {
  EXAM
  PRACTICE
}

enum InstructorType {
  SCHIMB
  BAZA
  EXAMEN
  SUPERIOR
}

model InstructorSubstitution {
  id                     Int        @id @default(autoincrement())
  baseInstructorId       Int
  substituteInstructorId Int
  date                   DateTime
  isActive               Boolean    @default(true)
  status                 String?    @default("SCHEDULED")  // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED
  color                  String?    @default("")           // UI персонализация
  privateMessage         String?    @default("")           // Заметки об подмене
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  baseInstructor         Instructor @relation("BaseInstructor", fields: [baseInstructorId], references: [id], onDelete: Cascade)
  substituteInstructor   Instructor @relation("SubstituteInstructor", fields: [substituteInstructorId], references: [id], onDelete: Cascade)

  @@unique([baseInstructorId, date])
  @@index([baseInstructorId])
  @@index([substituteInstructorId])
  @@index([date])
}


enum InstructorBlackoutType {
  SINGLE
  REPEAT
}

enum PracticalExamReservationStatus {
  SCHEDULED
  PASSED
  FAILED
  ABSENT
  CANCELLED
}

model PracticalExamSlot {
  id           Int                          @id @default(autoincrement())
  date         DateTime
  time         String
  sector       String
  gearbox      String
  capacity     Int
  isActive     Boolean                      @default(true)
  instructorId Int?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  instructor   Instructor?                  @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  reservations PracticalExamSlotReservation[]

  @@index([instructorId])
  @@index([date])
}

model PracticalExamSlotReservation {
  id            Int                            @id @default(autoincrement())
  slotId        Int
  userId        Int
  positionInCar Int
  color         String                         @default("")
  privateMessage String                        @default("")
  status        PracticalExamReservationStatus @default(SCHEDULED)
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  slot          PracticalExamSlot              @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([slotId, userId])
  @@index([slotId])
  @@index([userId])
}

model InstructorRating {
  id            Int        @id @default(autoincrement())
  userId        Int
  instructorId  Int
  reservationId Int        @unique
  rating        Int        /// 1–5
  comment       String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instructor    Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([userId, reservationId])
  @@index([instructorId])
  @@index([userId])
  @@index([createdAt])
}

model RecommendedVideo {
  id         Int      @id @default(autoincrement())
  title      String
  youtubeUrl String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sends      LessonVideoSend[]
}

model LessonVideoSend {
  id            Int              @id @default(autoincrement())
  reservationId Int              @unique
  userId        Int
  instructorId  Int
  videoId       Int
  createdAt     DateTime         @default(now())
  reservation   Reservation      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instructor    Instructor       @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  video         RecommendedVideo @relation(fields: [videoId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([instructorId])
  @@index([videoId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  body      String           @db.Text
  data      String?          @db.Text
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

enum NotificationType {
  LESSON_VIDEO
  LESSON_REMINDER
  EXAM_RESULT
  EXAM_DOCUMENT
  GENERAL
}

model ChatConversation {
  id        Int           @id @default(autoincrement())
  studentId Int           @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  student   User          @relation("ChatConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  senderId       Int?
  senderRole     Role
  body           String           @db.Text
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?            @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId])
}
