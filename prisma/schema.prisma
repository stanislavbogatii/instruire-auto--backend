generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                  Int                     @id @default(autoincrement())
  email               String                  @unique
  hash                String
  role                Role                    @default(USER)
  groupId             Int?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  firstName           String?                 @default("")
  lastName            String?                 @default("")
  phone               String?                 @default("")
  privateMessage      String?                 @default("")
  idnp                String?                 @default("")
  userId              Int?                    @unique
  exams               Exam[]
  instructorProfile   Instructor?             @relation("UserInstructor")
  reservations        Reservation[]
  changedReservations ReservationHistory[]    @relation("ChangedByUser")
  reservationHistory  ReservationHistory[]
  examPermissions     StudentExamPermission[]
  studentTickets      StudentTicket[]
  group               Group?                  @relation(fields: [groupId], references: [id])

  @@index([groupId], map: "User_groupId_fkey")
  @@index([userId], map: "User_userId_fkey")
}

model Group {
  id           Int         @id @default(autoincrement())
  name         String
  token        String      @unique
  instructorId Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  instructor   Instructor? @relation(fields: [instructorId], references: [id])
  users        User[]

  @@index([instructorId], map: "Group_instructorId_fkey")
}

model Reservation {
  id                 Int                  @id @default(autoincrement())
  userId             Int
  instructorId       Int?
  startTime          DateTime
  createdAt          DateTime             @default(now())
  gearbox            String?              @default("")
  privateMessage     String?              @default("")
  sector             String?              @default("")
  color              String?              @default("")
  carId              Int?
  instructorsGroupId Int?
  isConfirmed        Boolean              @default(false)
  updatedAt          DateTime             @default(now()) @updatedAt
  car                Car?                 @relation(fields: [carId], references: [id])
  instructor         Instructor?          @relation(fields: [instructorId], references: [id])
  instructorsGroup   InstructorsGroup?    @relation(fields: [instructorsGroupId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
  history            ReservationHistory[]

  @@index([instructorId], map: "Reservation_instructorId_fkey")
  @@index([userId], map: "Reservation_userId_fkey")
  @@index([carId], map: "Reservation_carId_fkey")
  @@index([instructorsGroupId])
}

model ReservationHistory {
  id                 Int               @id @default(autoincrement())
  reservationId      Int
  userId             Int
  instructorId       Int?
  carId              Int?
  instructorsGroupId Int?
  startTime          DateTime
  sector             String?           @default("")
  gearbox            String?           @default("")
  privateMessage     String?           @default("")
  color              String?           @default("")
  isConfirmed        Boolean           @default(false)
  action             HistoryAction
  changedBy          Int?
  changedFields      Json?
  createdAt          DateTime          @default(now())
  car                Car?              @relation(fields: [carId], references: [id])
  changedByUser      User?             @relation("ChangedByUser", fields: [changedBy], references: [id])
  instructor         Instructor?       @relation(fields: [instructorId], references: [id])
  instructorsGroup   InstructorsGroup? @relation(fields: [instructorsGroupId], references: [id])
  reservation        Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id])

  @@index([reservationId], map: "ReservationHistory_reservationId_fkey")
  @@index([userId], map: "ReservationHistory_userId_fkey")
  @@index([instructorId], map: "ReservationHistory_instructorId_fkey")
  @@index([carId], map: "ReservationHistory_carId_fkey")
  @@index([instructorsGroupId])
  @@index([changedBy], map: "ReservationHistory_changedBy_fkey")
}

model Car {
  id                 Int                  @id @default(autoincrement())
  plateNumber        String               @unique
  instructorId       Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  gearbox            String?
  instructor         Instructor?          @relation(fields: [instructorId], references: [id])
  reservations       Reservation[]
  reservationHistory ReservationHistory[]

  @@index([instructorId], map: "Car_instructorId_fkey")
}

model InstructorsGroup {
  id                 Int                  @id @default(autoincrement())
  name               String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sector             String?              @default("")
  order              Int                  @default(0)
  instructors        Instructor[]
  reservations       Reservation[]
  reservationHistory ReservationHistory[]
}

model Instructor {
  id                 Int                     @id @default(autoincrement())
  firstName          String
  lastName           String
  phone              String
  sector             String?                 @default("")
  isActive           Boolean                 @default(true)
  instructorsGroupId Int?
  userId             Int?                    @unique
  order              String?
  cars               Car[]
  exams              Exam[]
  groups             Group[]
  instructorsGroup   InstructorsGroup?       @relation(fields: [instructorsGroupId], references: [id])
  user               User?                   @relation("UserInstructor", fields: [userId], references: [id])
  reservations       Reservation[]
  reservationHistory ReservationHistory[]
  examPermissions    StudentExamPermission[]
  blackouts          InstructorBlackout[]

  @@index([instructorsGroupId])
  @@index([userId], map: "Instructor_userId_fkey")
}

model InstructorBlackout {
  id                 Int                  @id @default(autoincrement())
  dateTime           DateTime
  instructorId       Int 
  instructor         Instructor           @relation(fields: [instructorId], references: [id])
  
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([instructorId, dateTime])
}

model Question {
  id                   Int                   @id @default(autoincrement())
  text                 String                @db.Text
  image                String?
  answers              String                @db.Text
  correctAnswer        Int
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  examQuestions        ExamQuestion[]
  studentTicketAnswers StudentTicketAnswer[]
  ticketQuestions      TicketQuestion[]
}

model Ticket {
  id             Int              @id @default(autoincrement())
  name           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  type           QuestionType     @default(EXAM)
  examTickets    ExamTicket[]
  studentTickets StudentTicket[]
  questions      TicketQuestion[]
}

model TicketQuestion {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  questionId Int
  order      Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, questionId])
  @@index([ticketId])
  @@index([questionId])
}

model StudentTicket {
  id                Int                   @id @default(autoincrement())
  userId            Int
  ticketId          Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  completedAt       DateTime?
  lastQuestionIndex Int?
  score             Int?
  startedAt         DateTime?
  status            PracticeStatus        @default(NOT_STARTED)
  totalQuestions    Int?
  ticket            Ticket                @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers           StudentTicketAnswer[]

  @@unique([userId, ticketId])
  @@index([userId])
  @@index([ticketId])
}

model StudentTicketAnswer {
  id              Int           @id @default(autoincrement())
  studentTicketId Int
  questionId      Int
  selectedAnswer  Int?
  isCorrect       Boolean?
  answeredAt      DateTime?
  order           Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  question        Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentTicket   StudentTicket @relation(fields: [studentTicketId], references: [id], onDelete: Cascade)

  @@unique([studentTicketId, questionId])
  @@index([studentTicketId])
  @@index([questionId])
}

model Exam {
  id             Int            @id @default(autoincrement())
  userId         Int
  instructorId   Int?
  status         ExamStatus     @default(IN_PROGRESS)
  score          Int?
  totalQuestions Int            @default(0)
  passScore      Int            @default(22)
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  timeLimit      Int            @default(30)
  attemptNumber  Int            @default(1)
  instructor     Instructor?    @relation(fields: [instructorId], references: [id])
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions      ExamQuestion[]
  examTickets    ExamTicket[]

  @@index([userId])
  @@index([instructorId])
}

model ExamTicket {
  id       Int    @id @default(autoincrement())
  examId   Int
  ticketId Int
  exam     Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([examId, ticketId])
  @@index([examId])
  @@index([ticketId])
}

model ExamQuestion {
  id             Int       @id @default(autoincrement())
  examId         Int
  questionId     Int
  selectedAnswer Int?
  isCorrect      Boolean?
  answeredAt     DateTime?
  order          Int
  image          String?
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
}

model StudentExamPermission {
  id           Int         @id @default(autoincrement())
  userId       Int
  instructorId Int?
  granterId    Int         @default(0)
  granterType  Role        @default(INSTRUCTOR)
  isActive     Boolean     @default(true)
  validUntil   DateTime
  maxAttempts  Int         @default(3)
  usedAttempts Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  instructor   Instructor? @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([instructorId])
  @@index([granterId])
}

enum Role {
  USER
  MANAGER
  ADMIN
  INSTRUCTOR
}

enum HistoryAction {
  CREATE
  UPDATE
  DELETE
  CONFIRM
  UNCONFIRM
}

enum ExamStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
}

enum PracticeStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PASSED
  FAILED
}

enum QuestionType {
  EXAM
  PRACTICE
}
