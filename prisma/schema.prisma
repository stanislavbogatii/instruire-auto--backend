generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  hash         String
  firstName    String?       @default("")
  lastName     String?       @default("")
  phone        String?       @default("")
  privateMessage String?     @default("")
  role         Role          @default(USER)
  groupId      Int?
  userId       Int?          @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
  group        Group?        @relation(fields: [groupId], references: [id])
  instructorProfile Instructor? @relation("UserInstructor")

  @@index([groupId], map: "User_groupId_fkey")
  @@index([userId], map: "User_userId_fkey")
}

model Group {
  id           Int         @id @default(autoincrement())
  name         String
  token        String      @unique
  instructorId Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  instructor   Instructor? @relation(fields: [instructorId], references: [id])
  users        User[]

  @@index([instructorId], map: "Group_instructorId_fkey")
}

model Reservation {
  id                Int              @id @default(autoincrement())
  userId            Int
  instructorId      Int?
  carId             Int?
  instructorsGroupId Int?
  startTime         DateTime
  sector            String?         @default("")
  gearbox           String?         @default("")
  privateMessage    String?         @default("")
  color             String?         @default("")
  isConfirmed       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  instructor        Instructor?      @relation(fields: [instructorId], references: [id])
  user              User           @relation(fields: [userId], references: [id])
  car               Car?           @relation(fields: [carId], references: [id])
  instructorsGroup  InstructorsGroup? @relation(fields: [instructorsGroupId], references: [id])

  @@index([instructorId], map: "Reservation_instructorId_fkey")
  @@index([userId], map: "Reservation_userId_fkey")
  @@index([carId], map: "Reservation_carId_fkey")
  @@index([instructorsGroupId])
}

model Car {
  id          Int         @id @default(autoincrement())
  plateNumber String      @unique
  gearbox     String?     
  instructor  Instructor? @relation(fields: [instructorId], references: [id])
  instructorId Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  reservations Reservation[]

  @@index([instructorId], map: "Car_instructorId_fkey")
}

model InstructorsGroup {
  id           Int             @id @default(autoincrement())
  name         String
  order        Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  instructors  Instructor[]
  reservations Reservation[]
  sector       String?         @default("")
}

model Instructor {
  id                Int               @id @default(autoincrement())
  firstName        String
  lastName         String
  phone            String
  sector           String?           @default("") 
  isActive         Boolean           @default(true)
  userId           Int?              @unique
  instructorsGroup InstructorsGroup? @relation(fields: [instructorsGroupId], references: [id])
  instructorsGroupId Int?
  user             User?             @relation("UserInstructor", fields: [userId], references: [id])
  groups           Group[]
  reservations     Reservation[]
  cars             Car[]

  @@index([instructorsGroupId])
  @@index([userId], map: "Instructor_userId_fkey")
}

enum Role {
  USER
  MANAGER
  ADMIN
  INSTRUCTOR
}


